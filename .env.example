# 複製成 .env 後填入（.env 不會進 git）
# 1. Telegram 找 @BotFather → /newbot → 取得 token
TELEGRAM_BOT_TOKEN=
# 2. 傳任意訊息給你的 bot，再執行 uv run python scripts/telegram_setup.py 取得 chat id
TELEGRAM_CHAT_ID=
# 選填：已發布的報告網址，會附在推播訊息裡
REPORT_URL=
# 選填：AI 新聞與重大訊息檢查（Claude API 金鑰，console.anthropic.com 取得）
ANTHROPIC_API_KEY=
# 美股 SEC 財報需要的聯絡 email
SEC_CONTACT_EMAIL=
